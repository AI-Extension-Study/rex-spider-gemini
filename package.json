{
    "name": "@bric/rex-spider-gemini",
    "version": "0.0.1",
    "description": "Gemini plugin for REX spider module.",
    "keywords": [
        "extension",
        "rex"
    ],
    "author": "Behavioral Research Innovation Center",
    "type": "module",
    "main": "index.mts",
    "homepage": "https://github.com/bric-digital/rex-spider-gemini",
    "bugs": {
        "url": "https://github.com/bric-digital/rex-spider-gemini/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bric-digital/rex-spider-gemini.git"
    },
    "exports": {
        "./extension": "./src/extension.mts",
        "./browser": "./src/browser.mts",
        "./service-worker": "./src/service-worker.mts",
        "./spider": "./src/spider.mts"
    },
    "engines": {
        "node": ">=24.11"
    },
    "scripts": {
        "build": "tsc",
        "lint": "eslint src tests/unit tests/strip-node-modules-types.mjs",
        "test": "npm run test:unit && npm run test:specs",
        "test:unit": "node --disable-warning=ExperimentalWarning --import ./tests/strip-node-modules-types.mjs --test --test-timeout=60000 'tests/unit/**/*.test.mts'",
        "pretest:specs": "node tests/scripts/build-test-bundle.js",
        "test:specs": "playwright test",
        "test:ci": "npm run test:unit && npm run pretest:specs && playwright test --reporter=dot",
        "test:debug": "playwright test --debug",
        "test:headed": "playwright test --headed",
        "test:ui": "playwright test --ui"
    },
    "dependencies": {
        "@bric/rex-core": "github:bric-digital/rex-core",
        "@bric/rex-spider": "github:bric-digital/rex-spider"
    },
    "devDependencies": {
        "@types/node": "^24.19.2"
    }
}
